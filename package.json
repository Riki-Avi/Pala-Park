{
  "name": "pala-park",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pala/client",
    "dev:client": "npm run dev -w @pala/client",
    "dev:server": "npm run dev -w @pala/server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
